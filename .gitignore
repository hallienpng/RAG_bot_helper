
# Виртуальные окружения
.venv/
venv/
env/

# Python: кэш и временные файлы
__pycache__/
*.py[cod]
*.pyo

# Jupyter Notebook
.ipynb_checkpoints/

# Файлы и настройки IDE
.vscode/
.idea/

# Переменные окружения и секреты
.env
.env.*
!.env.example

# Системные файлы macOS
.DS_Store

# Кэш тестов
.pytest_cache/

# Локальные настройки Claude Code (общие .claude/skills и .mcp.json коммитим)
