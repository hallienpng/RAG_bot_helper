# Скопируйте этот файл в .env и заполните. Файл .env в git не попадает.

# --- LLM (любой OpenAI-совместимый API) ---
# OpenAI:      LLM_BASE_URL пустой, LLM_MODEL=gpt-4o-mini
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1, LLM_API_KEY=ollama, LLM_MODEL=qwen2.5:7b
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
# Если LLM_API_KEY пустой — бот работает без LLM и просто возвращает найденные фрагменты.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Поиск по базе знаний ---
KNOWLEDGE_DIR=knowledge_base
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
MIN_SCORE=0.05
